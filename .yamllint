---
extends: default

ignore: |
  .ansible/

rules:
  line-length:
    max: 200
    level: warning

  comments:
    min-spaces-from-content: 1

  comments-indentation: false

  braces:
    forbid: true

  brackets:
    forbid: non-empty

  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
