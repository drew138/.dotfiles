package config

import (
	"errors"
{{- if .Cache}}
	"fmt"
{{- end}}
	"os"
{{- if .Cache}}
	"time"
{{- end}}
)

type Config struct {
	HTTPAddr    string
{{- if .GRPC}}
	GRPCAddr    string
{{- end}}
	DatabaseURL string
{{- if .Cache}}
	RedisAddr   string
	CacheTTL    time.Duration
{{- end}}
}

func Load() (Config, error) {
	cfg := Config{
		HTTPAddr:    env("HTTP_ADDR", ":8080"),
{{- if .GRPC}}
		GRPCAddr:    env("GRPC_ADDR", ":9090"),
{{- end}}
		DatabaseURL: os.Getenv("DATABASE_URL"),
{{- if .Cache}}
		RedisAddr:   env("REDIS_ADDR", "localhost:6379"),
{{- end}}
	}
	if cfg.DatabaseURL == "" {
		return Config{}, errors.New("DATABASE_URL is required")
	}
{{- if .Cache}}

	ttl, err := time.ParseDuration(env("CACHE_TTL", "5m"))
	if err != nil {
		return Config{}, fmt.Errorf("parsing CACHE_TTL: %w", err)
	}
	cfg.CacheTTL = ttl
{{- end}}
	return cfg, nil
}

func env(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
