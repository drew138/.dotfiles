package rest

import (
	"context"
	"errors"
	"net/http"

	"{{.Module}}/internal/domain"
)

func map{{.Entity}}Response({{.Var}} domain.{{.Entity}}) {{.Entity}}Response {
	return {{.Entity}}Response{
		ID: {{.Var}}.ID,
{{- range .Fields}}{{if not .Secret}}
		{{.Name}}: {{$.Var}}.{{.Name}},
{{- end}}{{end}}
	}
}

func mapErrorResponse(err error) (int, ErrorResponse) {
	var violations *domain.ViolationError
	status, body := http.StatusInternalServerError, ErrorBody{Code: "internal", Message: "Something went wrong."}
	switch {
	case errors.Is(err, errBodyTooLarge):
		status, body = http.StatusRequestEntityTooLarge, ErrorBody{Code: "body_too_large", Message: "The request body is too large."}
	case errors.Is(err, errMalformedBody):
		status, body = http.StatusBadRequest, ErrorBody{Code: "malformed_request", Message: "The request body is not valid JSON."}
	case errors.As(err, &violations) && errors.Is(err, domain.ErrConflict):
		status, body = http.StatusConflict, ErrorBody{Code: "conflict", Message: "The request conflicts with existing data.", Fields: mapFieldResponses(violations.Violations)}
	case errors.As(err, &violations):
		status, body = http.StatusUnprocessableEntity, ErrorBody{Code: "invalid_argument", Message: "The request has invalid fields.", Fields: mapFieldResponses(violations.Violations)}
	case errors.Is(err, domain.ErrConflict):
		status, body = http.StatusConflict, ErrorBody{Code: "conflict", Message: "The request conflicts with existing data."}
	case errors.Is(err, domain.ErrInvalid):
		status, body = http.StatusUnprocessableEntity, ErrorBody{Code: "invalid_argument", Message: "The request is invalid."}
	case errors.Is(err, domain.ErrNotFound):
		status, body = http.StatusNotFound, ErrorBody{Code: "not_found", Message: "The resource does not exist."}
	case errors.Is(err, domain.ErrUnavailable), errors.Is(err, context.DeadlineExceeded):
		status, body = http.StatusServiceUnavailable, ErrorBody{Code: "unavailable", Message: "The service is temporarily unavailable. Try again later."}
	}
	return status, ErrorResponse{Error: body}
}

func mapFieldResponses(violations []domain.Violation) []FieldResponse {
	fields := make([]FieldResponse, 0, len(violations))
	for _, v := range violations {
		fields = append(fields, FieldResponse{Field: v.Field, Rule: v.Rule, Message: ruleMessage(v)})
	}
	return fields
}
