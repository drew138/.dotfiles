package redis

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"log/slog"
	"time"

	goredis "github.com/redis/go-redis/v9"

	"{{.Module}}/internal/application"
	"{{.Module}}/internal/domain"
)

type Cache struct {
	client *goredis.Client
	repo   application.Repository
	ttl    time.Duration
	log    *slog.Logger
}

func New(client *goredis.Client, repo application.Repository, ttl time.Duration, log *slog.Logger) *Cache {
	return &Cache{client: client, repo: repo, ttl: ttl, log: log}
}

func (c *Cache) Save(ctx context.Context, {{.Var}} domain.{{.Entity}}) (domain.{{.Entity}}, error) {
	return c.repo.Save(ctx, {{.Var}})
}

func (c *Cache) Find(ctx context.Context, id int64) (domain.{{.Entity}}, error) {
	key := {{.Var}}Key(id)
	if cached, ok := c.read(ctx, key); ok {
		return cached, nil
	}

	{{.Var}}, err := c.repo.Find(ctx, id)
	if err != nil {
		return domain.{{.Entity}}{}, err
	}
	c.write(ctx, key, {{.Var}})
	return {{.Var}}, nil
}

func (c *Cache) read(ctx context.Context, key string) (domain.{{.Entity}}, bool) {
	payload, err := c.client.Get(ctx, key).Bytes()
	if errors.Is(err, goredis.Nil) {
		return domain.{{.Entity}}{}, false
	}
	if err != nil {
		c.log.WarnContext(ctx, "reading cache", "key", key, "error", err)
		return domain.{{.Entity}}{}, false
	}

	var entry {{.Var}}Entry
	if err := json.Unmarshal(payload, &entry); err != nil {
		c.log.WarnContext(ctx, "decoding cache entry", "key", key, "error", err)
		return domain.{{.Entity}}{}, false
	}
	return entry.toDomain(), true
}

func (c *Cache) write(ctx context.Context, key string, {{.Var}} domain.{{.Entity}}) {
	payload, err := json.Marshal(map{{.Entity}}Entry({{.Var}}))
	if err != nil {
		c.log.WarnContext(ctx, "encoding cache entry", "key", key, "error", err)
		return
	}
	if err := c.client.Set(ctx, key, payload, c.ttl).Err(); err != nil {
		c.log.WarnContext(ctx, "writing cache", "key", key, "error", err)
	}
}

func {{.Var}}Key(id int64) string {
	return fmt.Sprintf("{{.Snake}}:%d", id)
}
