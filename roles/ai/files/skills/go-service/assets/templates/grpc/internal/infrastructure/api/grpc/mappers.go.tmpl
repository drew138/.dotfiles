package grpc

import (
	"google.golang.org/genproto/googleapis/rpc/errdetails"
{{- if .HasTime}}
	"google.golang.org/protobuf/types/known/timestamppb"
{{- end}}

	"{{.Module}}/internal/domain"
	"{{.Module}}/internal/infrastructure/api/grpc/pb"
)

func mapDomain{{.Entity}}(req *pb.Create{{.Entity}}Request) domain.{{.Entity}} {
	return domain.{{.Entity}}{
{{- range .Fields}}
		{{.Name}}: {{.FromProto}},
{{- end}}
	}
}

func map{{.Entity}}Message(e domain.{{.Entity}}) *pb.{{.Entity}} {
	return &pb.{{.Entity}}{
		Id: e.ID,
{{- range .Fields}}{{if not .Secret}}
		{{.ProtoGoName}}: {{.ToProto}},
{{- end}}{{end}}
	}
}

func mapBadRequest(violations []domain.Violation) *errdetails.BadRequest {
	fields := make([]*errdetails.BadRequest_FieldViolation, 0, len(violations))
	for _, v := range violations {
		fields = append(fields, &errdetails.BadRequest_FieldViolation{Field: v.Field, Description: v.Rule})
	}
	return &errdetails.BadRequest{FieldViolations: fields}
}
