package grpc

import (
	"{{.Module}}/internal/domain"
	"{{.Module}}/internal/infrastructure/api/grpc/pb"
)

func validateCreate{{.Entity}}Request(req *pb.Create{{.Entity}}Request) []domain.Violation {
	var violations []domain.Violation
{{- range .Fields}}
{{- if eq .Type "string"}}
	if req.Get{{.ProtoGoName}}() == "" {
		violations = append(violations, domain.Violation{Field: "{{.JSON}}", Rule: "required"})
	}
{{- else if eq .Type "time.Time"}}
	if req.Get{{.ProtoGoName}}() == nil {
		violations = append(violations, domain.Violation{Field: "{{.JSON}}", Rule: "required"})
	}
{{- end}}
{{- end}}
	return violations
}
