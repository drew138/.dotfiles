package mysql

import (
{{- if .HasTime}}
	"time"
{{- end}}

	"{{.Module}}/internal/domain"
)

type {{.Var}}Row struct {
	ID int64 `db:"id"`
{{- range .Fields}}
	{{.Name}} {{.Type}} `db:"{{.Column}}"`
{{- end}}
}

func (r {{.Var}}Row) toDomain() domain.{{.Entity}} {
	return domain.{{.Entity}}{
		ID: r.ID,
{{- range .Fields}}
		{{.Name}}: r.{{.Name}},
{{- end}}
	}
}
