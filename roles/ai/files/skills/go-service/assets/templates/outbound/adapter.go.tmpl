package tech

import (
	"context"
	"fmt"

	"module/internal/domain"
)

var constraintErrors = map[string]error{
	"entities_name_key": domain.ErrEntityNameTaken,
}

type Repository struct {
	client *Client
}

func New(client *Client) *Repository {
	return &Repository{client: client}
}

func (r *Repository) Save(ctx context.Context, entity domain.Entity) (domain.Entity, error) {
	row := mapEntityRow(entity)
	if err := r.client.Upsert(ctx, &row); err != nil {
		return domain.Entity{}, domainError(err, fmt.Sprintf("saving entity %d", entity.ID))
	}
	return row.toDomain(), nil
}

func (r *Repository) Find(ctx context.Context, id int64) (domain.Entity, error) {
	var row entityRow
	if err := r.client.Get(ctx, id, &row); err != nil {
		return domain.Entity{}, domainError(err, fmt.Sprintf("finding entity %d", id))
	}
	return row.toDomain(), nil
}

func domainError(err error, doing string) error {
	switch {
	case isNotFound(err):
		return domain.ErrNotFound
	case constraintName(err) != "":
		if mapped, ok := constraintErrors[constraintName(err)]; ok {
			return fmt.Errorf("%s: %w", doing, mapped)
		}
		return fmt.Errorf("%s: %w: %w", doing, constraintKind(err), err)
	case isUnavailable(err):
		return fmt.Errorf("%s: %w: %w", doing, domain.ErrUnavailable, err)
	default:
		return fmt.Errorf("%s: %w: %w", doing, domain.ErrInternal, err)
	}
}
