[user]
	email = 58788781+drew138@users.noreply.github.com
	name = Andres Salazar Galeano
    signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINwfcQvHi11MBh2MT/D0i+cqKunTcdSW/fYalR04wLCc
[core]
	editor = nvim
	symlinks = false
	excludesfile = ~/.gitignore_global
[advice]
    addEmptyPathSpec = false
[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
[push]
	default = current
[pull]
	rebase = false
[alias]
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
[merge]
	tool = nvimdiff
[mergetool]
	keepBackup = false
    nodiff = true
[mergetool "nvimdiff"]
    trustExitCode = false
    layout = "MERGED"
[init]
    defaultBranch = main
[commit]
	gpgsign = true
[gpg]
    format = ssh
[includeIf "gitdir:~/work/**/"]
    path = ~/.work.gitconfig
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
